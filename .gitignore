# Combined .gitignore for Visual Studio C#/.NET and C++ projects

########## Core ##########
*.user
*.userosscache
*.suo
*.sln.docstates
*.psess
*.vsp
*.vspx
*.pidb
*.svclog
*.opendb
*.VC.db
*.VC.VC.opendb
*.cache
*.tmp
*.temp
*.log
*.dmp
*.trace
*.tlog
*.lastbuildstate

# OS junk
.DS_Store
Thumbs.db
$RECYCLE.BIN/

########## Visual Studio ##########
.vs/

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Bb]uild[Ll]og.*
[Bb]uild/[Ll]og/

# Config transforms (generated)
*.rdlc

# Test
[Tt]est[Rr]esults*/
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

########## .NET/NuGet ##########
# NuGet
*.nupkg
*.snupkg
# packages folder (NuGet restore)
packages/*
!packages/build/
!packages/repositories.config
.nuget/NuGet.exe
.nuget/packages.config
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
app.publish/
[Pp]ublish*/

# Entity Framework
*_i.c
*_p.c
*_h.h
*.dbmdl

########## C# specific outputs ##########
# Common managed build artifacts
*.dll
*.exe
*.xml
*.mdb
*.pdb

########## C/C++ native ##########
# Intermediate and output
*.obj
*.iobj
*.ipdb
*.idb
*.pdb
*.ilk
*.exp
*.lib
*.efi
*.rom
*.map
*.sbr
*.pch
*.aps
*.res
*.rsp
*.tlh
*.tli
*.manifest

# IntelliSense
ipch/
*.ipch

# Architecture-specific output dirs
x64/
x86/
ARM/
ARM64/
bld/

########## IDEs/Tools ##########
# Rider / ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/

########## Source control (legacy) ##########
*.vssscc
*.vspscc

########## Azure/Packaging ##########
*.appx
*.appxupload
*.msi
*.msix
*.msm
*.cab

# Local tooling/secrets (keep your own patterns here)
.env.local
secrets.json
