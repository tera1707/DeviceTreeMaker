<Window x:Class="DeviceTreeJikken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceTreeJikken"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <ListBox x:Name="DeviceListView"
                 PreviewMouseRightButtonDown="DeviceListView_PreviewMouseRightButtonDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="{Binding IconMargin}"/>
                        <TextBlock Text="{Binding IndentedDisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{Binding DisplayNameMenuText}" Tag="{Binding DisplayName}" Click="CopyMenuItemToClipboard"/>
                    <MenuItem Header="{Binding ClassNameMenuText}" Tag="{Binding ClassName}" Click="CopyMenuItemToClipboard"/>
                    <MenuItem Header="{Binding DeviceInstancePathMenuText}" Tag="{Binding DeviceInstancePath}" Click="CopyMenuItemToClipboard"/>
                    <MenuItem Header="ハードウェアID" ItemsSource="{Binding HardwareIds}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding}"/>
                                <Setter Property="Tag" Value="{Binding}"/>
                                <EventSetter Event="Click" Handler="CopyMenuItemToClipboard"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</Window>
